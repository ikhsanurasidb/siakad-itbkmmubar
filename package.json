{
  "name": "siakad-itbkmmubar",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/node": "^26.4.1",
      "varlock": "1.18.0",
      "@cloudflare/workers-types": "^5.20260906.1",
      "@orpc/server": "^1.15.0",
      "@orpc/openapi": "^1.15.0",
      "@orpc/zod": "^1.15.0",
      "better-auth": "1.7.5",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "@orpc/client": "^1.15.0",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev:bare -F web --",
    "dev:server": "turbo run dev:bare -F hono --",
    "seed:superadmin": "bun scripts/seed-superadmin.ts",
    "db:generate": "turbo run db:generate -F @siakad-itbkmmubar/db --",
    "deploy": "turbo run deploy -F @siakad-itbkmmubar/infra --",
    "destroy": "turbo run destroy -F @siakad-itbkmmubar/infra --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "check": "ultracite check",
    "lint": "ultracite check",
    "fix": "ultracite fix",
    "doctor": "ultracite doctor",
    "react-doctor": "react-doctor",
    "test": "bun test",
    "test:unit": "bun test tests",
    "test:integration": "bun test tests",
    "test:e2e": "bun test tests",
    "verify": "bun run check && bun run check-types && bun run test && bun run build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "catalog:",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@siakad-itbkmmubar/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "react-doctor": "^0.9.14",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.11.0",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.0"
}
