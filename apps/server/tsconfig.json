{
  "extends": "@siakad-itbkmmubar/config/tsconfig.base.json",
  "references": [
    { "path": "../../packages/api" },
    { "path": "../../packages/uuid" }
  ],
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@server/*": ["./src/*"],
      "@api/*": ["../../packages/api/src/*"],
      "@auth/*": ["../../packages/auth/src/*"],
      "@db/*": ["../../packages/db/src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "strictNullChecks": true
  }
}
